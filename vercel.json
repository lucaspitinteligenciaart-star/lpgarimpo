{
  "redirects": [
    { "source": "/es", "destination": "/", "permanent": false },
    { "source": "/es/(.*)", "destination": "/", "permanent": false },
    { "source": "/quiz", "destination": "/", "permanent": false },
    { "source": "/quiz/(.*)", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
